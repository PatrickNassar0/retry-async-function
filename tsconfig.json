{
  "compilerOptions": {
    "target": "ES2017",                  // Reasonable modern target, widely supported
    "module": "ESNext",                  // Allows bundlers to optimize via tree-shaking
    "moduleResolution": "node",
    "declaration": true,                 // Generate .d.ts files
    "outDir": "build",
    "rootDir": "src",
    "esModuleInterop": true,             // Better compatibility with CommonJS modules
    "forceConsistentCasingInFileNames": true,
    "strict": true,                      // Enables all strict type-checking options
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true                    // Optional: helpful for debugging
  },
  "include": ["src"],
  "exclude": ["node_modules", "build"]
}
